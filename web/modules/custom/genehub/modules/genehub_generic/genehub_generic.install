<?php

/**
 * @file
 * Install and update hooks for the GeneHub Generic Product module.
 */

declare(strict_types=1);

use Drupal\Component\Serialization\Yaml;
use Drupal\Core\Utility\UpdateException;

/**
 * Converts existing generic products to the first revision of each entity.
 */
function genehub_generic_update_11001(array &$sandbox): void {
  $entity_type_id = 'product_generic';
  $entity_type = \Drupal::entityTypeManager()->getDefinition($entity_type_id);
  $field_storage_definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions($entity_type_id);

  \Drupal::entityDefinitionUpdateManager()->updateFieldableEntityType(
    $entity_type,
    $field_storage_definitions,
    $sandbox,
  );
}

/**
 * Backfills metadata for the initial generic product revisions.
 */
function genehub_generic_update_11002(): void {
  $entity_type_id = 'product_generic';
  $entity_type = \Drupal::entityTypeManager()->getDefinition($entity_type_id);
  $database = \Drupal::database();
  $schema = $database->schema();
  $revision_table = $entity_type->getRevisionTable();
  $data_table = $entity_type->getDataTable();

  if (!$schema->tableExists($revision_table) || !$schema->tableExists($data_table)) {
    return;
  }

  $initial_revision_log = 'Initial revision migrated from existing entity data.';
  $request_time = \Drupal::time()->getRequestTime();
  $rows = $database->select($data_table, 'data')
    ->fields('data', ['id', 'uid', 'created', 'changed'])
    ->execute();

  foreach ($rows as $row) {
    $database->update($revision_table)
      ->fields([
        'revision_uid' => $row->uid !== NULL ? (int) $row->uid : NULL,
        'revision_timestamp' => (int) ($row->changed ?: $row->created ?: $request_time),
        'revision_log' => $initial_revision_log,
      ])
      ->condition('revision_id', (int) $row->id)
      ->condition('revision_timestamp', NULL, 'IS NULL')
      ->execute();
  }
}

/**
 * Updates the allowed values of product_kind to include INN.
 */
function genehub_generic_update_11003(): void {
  $field_storage_definition = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('product_generic')['product_kind'] ?? NULL;

  if ($field_storage_definition !== NULL) {
    \Drupal::entityDefinitionUpdateManager()->updateFieldStorageDefinition($field_storage_definition);
  }
}

/**
 * Makes publication status independent for each product translation.
 */
function genehub_generic_update_11004(): void {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $definition = $update_manager->getFieldStorageDefinition('status', 'product_generic');

  if ($definition !== NULL && !$definition->isTranslatable()) {
    // Both current and revision status values already have per-language rows.
    // Updating the definition preserves those values; do not resave products or
    // copy the current status over historical revisions or other translations.
    $definition->setTranslatable(TRUE);
    $update_manager->updateFieldStorageDefinition($definition);
  }
}

/**
 * Installs the product administration View without replacing customized Views.
 */
function genehub_generic_update_11005(): void {
  if (!\Drupal::moduleHandler()->moduleExists('views')) {
    throw new UpdateException('Enable Views before updating the product administration lists.');
  }
  $name = 'views.view.genehub_generic_products';
  if (!\Drupal::configFactory()->get($name)->isNew()) {
    return;
  }
  $path = \Drupal::service('extension.list.module')->getPath('genehub_generic');
  $data = Yaml::decode(file_get_contents($path . '/config/optional/' . $name . '.yml'));
  \Drupal::entityTypeManager()->getStorage('view')->create($data)->save();
}

/**
 * Adds slug search, sortable columns and native sticky bulk action markup.
 */
function genehub_generic_update_11006(): void {
  $name = 'views.view.genehub_generic_products';
  $config = \Drupal::configFactory()->getEditable($name);
  if ($config->isNew()) {
    return;
  }
  $path = \Drupal::service('extension.list.module')->getPath('genehub_generic');
  $defaults = Yaml::decode(file_get_contents($path . '/config/optional/' . $name . '.yml'));
  $options = $defaults['display']['default']['display_options'];
  $fields = $config->get('display.default.display_options.fields');
  $updated = [];
  foreach ($fields as $key => $field) {
    if ($key === 'bulk_form') {
      $key = 'product_bulk_form';
      $field['id'] = $key;
    }
    $updated[$key] = $field;
    if ($key === 'product_name') {
      $updated['slug'] = $options['fields']['slug'];
    }
  }
  $config->set('display.default.display_options.fields', $updated)
    ->set('display.default.display_options.filters.slug', $options['filters']['slug'])
    ->set('display.default.display_options.style.options', $options['style']['options'])->save();
}
