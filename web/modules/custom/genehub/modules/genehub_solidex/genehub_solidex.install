<?php

/**
 * @file
 * Install and update hooks for the GeneHub SOLIDEX module.
 */

declare(strict_types=1);

/**
 * Migrates the Storage field from a short string to a long plain-text field.
 *
 * The field may already contain product data, so the database column is
 * changed explicitly before the entity definition is recorded as updated.
 */
function genehub_solidex_update_11001(): void {
  $entity_type_id = 'product_solidex';
  $field_name = 'storage';
  $entity_type = \Drupal::entityTypeManager()->getDefinition($entity_type_id);
  $field_storage_definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions($entity_type_id);
  $storage_definition = $field_storage_definitions[$field_name] ?? NULL;

  if ($storage_definition === NULL) {
    return;
  }

  $database_schema = \Drupal::database()->schema();
  $data_table = $entity_type->getDataTable();
  $field_exists = $database_schema->tableExists($data_table)
    && $database_schema->fieldExists($data_table, $field_name);

  if ($field_exists) {
    // Keep existing values while widening varchar(255) to longtext.
    $database_schema->changeField($data_table, $field_name, $field_name, [
      'type' => 'text',
      'size' => 'big',
      'not null' => FALSE,
    ]);
    // The column change was handled above; Drupal should only persist the
    // updated field schema and installed definition from this point on.
    $storage_definition->setSetting('column_changes_handled', TRUE);
  }

  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($entity_definition_update_manager->getFieldStorageDefinition($field_name, $entity_type_id) !== NULL) {
    $entity_definition_update_manager->updateFieldStorageDefinition($storage_definition);
  }
  else {
    $entity_definition_update_manager->installFieldStorageDefinition(
      $field_name,
      $entity_type_id,
      'genehub_solidex',
      $storage_definition,
    );
  }
}

/**
 * Converts existing SOLIDEX products to the first revision of each entity.
 */
function genehub_solidex_update_11002(array &$sandbox): void {
  $entity_type_id = 'product_solidex';
  $entity_type = \Drupal::entityTypeManager()->getDefinition($entity_type_id);
  $field_storage_definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions($entity_type_id);

  \Drupal::entityDefinitionUpdateManager()->updateFieldableEntityType(
    $entity_type,
    $field_storage_definitions,
    $sandbox,
  );
}

/**
 * Backfills metadata for the initial SOLIDEX product revisions.
 */
function genehub_solidex_update_11003(): void {
  $entity_type_id = 'product_solidex';
  $entity_type = \Drupal::entityTypeManager()->getDefinition($entity_type_id);
  $database = \Drupal::database();
  $schema = $database->schema();
  $revision_table = $entity_type->getRevisionTable();
  $data_table = $entity_type->getDataTable();

  if (!$schema->tableExists($revision_table) || !$schema->tableExists($data_table)) {
    return;
  }

  $initial_revision_log = 'Initial revision migrated from existing entity data.';
  $request_time = \Drupal::time()->getRequestTime();
  $rows = $database->select($data_table, 'data')
    ->fields('data', ['id', 'uid', 'created', 'changed'])
    ->execute();

  foreach ($rows as $row) {
    $database->update($revision_table)
      ->fields([
        'revision_uid' => $row->uid !== NULL ? (int) $row->uid : NULL,
        'revision_timestamp' => (int) ($row->changed ?: $row->created ?: $request_time),
        'revision_log' => $initial_revision_log,
      ])
      ->condition('revision_id', (int) $row->id)
      ->condition('revision_timestamp', NULL, 'IS NULL')
      ->execute();
  }
}
