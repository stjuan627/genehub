<?php

/**
 * @file
 * Provides hooks for the GeneHub parent module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\menu_link_content\MenuLinkContentInterface;
use Drupal\node\NodeInterface;
use Drupal\system\MenuInterface;

/**
 * Implements hook_ENTITY_TYPE_insert() for nodes.
 */
function genehub_node_insert(NodeInterface $node): void {
  genehub_invalidate_page($node);
}

/**
 * Implements hook_ENTITY_TYPE_update() for nodes.
 */
function genehub_node_update(NodeInterface $node): void {
  genehub_invalidate_page($node);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for nodes.
 */
function genehub_node_delete(NodeInterface $node): void {
  if ($node->bundle() === 'page' && !\Drupal::service('workspaces.manager')->hasActiveWorkspace()) {
    \Drupal::service('genehub.menu_cache_invalidator')->enqueuePage($node->uuid(), '*');
  }
}

/**
 * Invalidates languages whose public page representation has changed.
 */
function genehub_invalidate_page(NodeInterface $node): void {
  if ($node->bundle() !== 'page' || !$node->isDefaultRevision() || \Drupal::service('workspaces.manager')->hasActiveWorkspace()) {
    return;
  }
  $sender = \Drupal::service('genehub.menu_cache_invalidator');
  $old = $node->getOriginal();
  if (!$old || $node->isSyncing()) {
    $sender->enqueuePage($node->uuid(), '*');
    return;
  }
  foreach ($node->getTranslationLanguages() + $old->getTranslationLanguages() as $lang => $language) {
    $before = $old->hasTranslation($lang) ? $old->getTranslation($lang) : NULL;
    $after = $node->hasTranslation($lang) ? $node->getTranslation($lang) : NULL;
    if (!$before?->isPublished() && !$after?->isPublished()) {
      continue;
    }
    if (!$before || !$after || $before->isPublished() !== $after->isPublished()) {
      $sender->enqueuePage($node->uuid(), $lang);
      continue;
    }
    foreach (['title', 'body', 'field_meta_description'] as $field) {
      if ($after->hasField($field) && !$after->get($field)->equals($before->get($field))) {
        $sender->enqueuePage($node->uuid(), $lang);
        break;
      }
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for menu links.
 */
function genehub_menu_link_content_insert(MenuLinkContentInterface $link): void {
  genehub_menu_link_invalidate($link);
}

/**
 * Implements hook_ENTITY_TYPE_update() for menu links.
 */
function genehub_menu_link_content_update(MenuLinkContentInterface $link): void {
  genehub_menu_link_invalidate($link);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for menu links.
 */
function genehub_menu_link_content_delete(MenuLinkContentInterface $link): void {
  genehub_menu_link_invalidate($link);
}

/**
 * Implements hook_ENTITY_TYPE_insert() for menus.
 */
function genehub_menu_insert(MenuInterface $menu): void {
  \Drupal::service('genehub.menu_cache_invalidator')->enqueue($menu->id());
}

/**
 * Implements hook_ENTITY_TYPE_delete() for menus.
 */
function genehub_menu_delete(MenuInterface $menu): void {
  \Drupal::service('genehub.menu_cache_invalidator')->enqueue($menu->id());
}

/**
 * Invalidates the live menu, including the source menu when a link is moved.
 */
function genehub_menu_link_invalidate(MenuLinkContentInterface $link): void {
  if (!$link->isDefaultRevision() || \Drupal::service('workspaces.manager')->hasActiveWorkspace()) {
    return;
  }
  $invalidator = \Drupal::service('genehub.menu_cache_invalidator');
  $invalidator->enqueue($link->getMenuName());
  $previous = $link->getOriginal()?->getMenuName();
  if ($previous !== NULL && $previous !== $link->getMenuName()) {
    $invalidator->enqueue($previous);
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for menu link forms.
 */
function genehub_form_menu_link_content_form_alter(array &$form, FormStateInterface $form_state): void {
  $link = $form_state->getFormObject()->getEntity();
  if (!$link instanceof MenuLinkContentInterface || !str_starts_with($link->getMenuName(), 'genemedi-header-')) {
    return;
  }

  $options = $link->get('link')->first()?->options['genemedi'] ?? [];
  $form['genemedi_icon'] = [
    '#type' => 'textfield',
    '#title' => t('GeneMedi icon ID'),
    '#default_value' => $options['icon'] ?? '',
    '#maxlength' => 100,
    '#pattern' => '[a-zA-Z0-9_-]*',
    '#weight' => 1,
  ];
  $form['genemedi_badge'] = [
    '#type' => 'select',
    '#title' => t('GeneMedi badge'),
    '#options' => [
      '' => t('None'),
      'hot' => t('Hot!'),
      'new' => t('New!'),
    ],
    '#default_value' => $options['badge'] ?? '',
    '#weight' => 2,
  ];
  $form['#entity_builders'][] = 'genehub_build_genemedi_menu_link';
}

/**
 * Saves GeneMedi display options alongside the link destination.
 */
function genehub_build_genemedi_menu_link(string $entity_type, MenuLinkContentInterface $entity, array $form, FormStateInterface $form_state): void {
  $link = $entity->get('link')->first();
  if ($link === NULL) {
    return;
  }
  $options = $link->options ?? [];
  $options['genemedi'] = [
    'icon' => (string) $form_state->getValue('genemedi_icon'),
    'badge' => (string) $form_state->getValue('genemedi_badge'),
  ];
  $link->options = $options;
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node forms.
 */
function genehub_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof EntityFormInterface) {
    return;
  }

  $node = $form_object->getEntity();
  if (!$node instanceof NodeInterface || $node->bundle() !== 'page') {
    return;
  }

  $form['path']['genehub_route_sync_enabled'] = [
    '#type' => 'checkbox',
    '#title' => t('Synchronize slug to the legacy site'),
    '#default_value' => FALSE,
    '#parents' => ['genehub_route_sync_enabled'],
    '#weight' => 40,
  ];

  foreach ($form['actions'] as $action_name => &$action) {
    if ($action_name !== 'preview' && ($action['#type'] ?? NULL) === 'submit' && isset($action['#submit'])) {
      $action['#submit'][] = 'genehub_basic_page_route_sync_submit';
    }
  }
}

/**
 * Synchronizes a saved Basic Page slug when explicitly requested.
 */
function genehub_basic_page_route_sync_submit(array &$form, FormStateInterface $form_state): void {
  if (!$form_state->getValue('genehub_route_sync_enabled')) {
    return;
  }

  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof EntityFormInterface) {
    return;
  }

  $node = $form_object->getEntity();
  if (!$node instanceof NodeInterface || $node->bundle() !== 'page' || $node->isNew()) {
    return;
  }

  $slug = $node->hasField('field_slug') ? trim((string) $node->get('field_slug')->value) : '';
  $route_path = ltrim($slug, '/');

  \Drupal::service('genehub.product_route_sync_client')
    ->sync($node, $route_path, 'basic_page');
}
